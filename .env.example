# API
PORT=3000
NODE_ENV=Development

# Auth (production: set a long random secret; never commit a real value)
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=1h

# Database (local docker-compose default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simsimplay

# Redis (local docker-compose default)
REDIS_URL=redis://localhost:6379

# Frontend
VITE_API_BASE_URL=http://localhost:3000
